# =============================================================================
#  Hostinger (LiteSpeed/Apache) rules for sheontherun.com
#  GitHub Pages ignores this file, so it is harmless there.
# =============================================================================

Options -Indexes
DirectoryIndex index.html

# >>> PRIVATE PREVIEW — DELETE THIS WHOLE BLOCK (down to the "<<<" line) TO LAUNCH >>>
# Until the owner says go, visitors get a password prompt. /admin and /api have their own
# sign-in (admin/.htaccess, api/.htaccess lift this prompt), and /.well-known stays open so
# the SSL certificate can renew. The password file lives outside the web folder.
AuthType Basic
AuthName "SheOnTheRun - private preview"
AuthUserFile /home/u586950607/domains/sheontherun.com/.htpasswd
SetEnvIf Request_URI "^/\.well-known/" PUBLIC_PATH
<RequireAny>
  Require valid-user
  Require env PUBLIC_PATH
</RequireAny>
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
# <<< END PRIVATE PREVIEW <<<

<IfModule mod_rewrite.c>
RewriteEngine On

# One canonical address: https://sheontherun.com  (no www, always HTTPS) — a single redirect hop.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Private things are never served: backend code, plans, tooling, hidden files, deploy leftovers.
RewriteRule ^(server|docs|tools|\.git|\.github|\.claude)(/|$) - [F,L]
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule \.(md|py|exe|sqlite|sql|log)$ - [F,L]
RewriteRule ^\.ftp-deploy - [F,L]

# Everything under /api goes to the one PHP front controller.
RewriteRule ^api(/.*)?$ api/index.php [L]
</IfModule>

ErrorDocument 403 /404.html
ErrorDocument 404 /404.html

# ----------------------------------------------------------------- security
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=86400"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# -------------------------------------------------------------------- speed
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Cautious caching: the owner edits data/*.js, pages and photos in place under the same names,
# so nothing is cached for long. (Static assets are still re-checked cheaply with ETag/Last-Modified.)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 5 minutes"
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType text/javascript "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>
